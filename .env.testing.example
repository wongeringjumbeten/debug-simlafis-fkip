APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Isolated PostgreSQL database. Never point tests at the shared development DB.
DB_CONNECTION=pgsql
# Copy the PostgreSQL host, port, username, password, and SSL mode from .env.
# Only DB_DATABASE differs: it MUST stay simlafis_testing.
DB_HOST=
DB_PORT=5432
DB_DATABASE=simlafis_testing
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=prefer

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
